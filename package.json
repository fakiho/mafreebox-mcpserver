{
  "name": "freebox-mcp",
  "version": "1.1.1",
  "description": "MCP Server pour piloter une Freebox via Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "freebox-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "sync": "node dist/agh-sync/index.js",
    "sync:authorize": "node dist/agh-sync/authorize.js",
    "sync:setup-blocklists": "node dist/agh-sync/setup-blocklists.js",
    "dev:sync": "tsx watch src/agh-sync/index.ts",
    "prepare": "npm run build",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
